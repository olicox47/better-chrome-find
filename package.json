{
  "name": "better-chrome-find",
  "version": "1.3.4",
  "private": true,
  "type": "module",
  "description": "Better Chrome Find: compact page search with case, whole-word and regex matching.",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "vitest run tests/matcher.test.ts tests/enablement.test.ts",
    "test:browser": "playwright test",
    "test:chrome": "node scripts/chrome-smoke.mjs",
    "screenshots": "npm run build && node scripts/readme-screenshots.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
